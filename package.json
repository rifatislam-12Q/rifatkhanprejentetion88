{
  "name": "green-shop-platform",
  "version": "1.0.0",
  "description": "Green Shop . Com - 7-Slide Enterprise Presentation Platform & Global E-Commerce Ecosystem",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "green-shop",
    "ecommerce",
    "presentation",
    "bangladesh",
    "react",
    "typescript",
    "tailwindcss",
    "vite"
  ],
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && vite build --outDir docs && cp -r docs/assets ./assets",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
